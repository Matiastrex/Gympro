// Esquema de datos de GymPro CRM.
// Diseñado para cubrir la Entrega Final desde el día 1: la Primera Entrega
// (MVP) solo expone por API/UI un subconjunto de estas tablas, pero el
// modelo ya está completo para no tener que migrar/rehacer datos después.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ---------- Enums ----------

enum Rol {
  ADMINISTRADOR
  VENDEDOR
  RESPONSABLE_COMERCIAL
}

enum EstadoEntidad {
  POTENCIAL
  CLIENTE
  INACTIVO
  NO_CONTACTAR
}

enum TipoEtapa {
  ABIERTA
  GANADA
  PERDIDA
  BAJA
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum TipoNotificacion {
  REAPERTURA_SOLICITADA
  REAPERTURA_APROBADA
  REAPERTURA_RECHAZADA
}

enum EstadoOportunidad {
  ABIERTA
  GANADA
  PERDIDA
  BAJA
}

// ---------- Usuarios (roles completos ya modelados; el MVP usa 1 solo rol) ----------

model Usuario {
  id           Int      @id @default(autoincrement())
  nombre       String
  apellido     String
  email        String   @unique
  passwordHash String
  rol          Rol      @default(VENDEDOR)
  activo       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  empresasResponsable   Empresa[]        @relation("ResponsableEmpresa")
  contactosResponsable  Contacto[]       @relation("ResponsableContacto")
  empresasCreadas       Empresa[]        @relation("CreadorEmpresa")
  contactosCreados      Contacto[]       @relation("CreadorContacto")
  oportunidades         Oportunidad[]    @relation("ResponsableOportunidad")
  actividades           Actividad[]
  cambiosDeEtapa        HistorialEtapa[]
  reaperturasPedidas    SolicitudReapertura[] @relation("SolicitanteReapertura")
  reaperturasResueltas  SolicitudReapertura[] @relation("ResolutorReapertura")
  notificaciones        Notificacion[]

  @@map("usuarios")
}

// ---------- Módulo 1: empresas y contactos ----------

model Empresa {
  id            Int           @id @default(autoincrement())
  razonSocial   String
  oportunidadAbiertaId Int?
  cuit          String?
  industria     String?
  email         String?
  telefono      String?
  direccion     String?
  sitioWeb      String?
  estado        EstadoEntidad @default(POTENCIAL)
  bajaDefinitiva Boolean      @default(false)
  origenId      Int?
  origen        Origen?       @relation(fields: [origenId], references: [id])
  observaciones String?       @db.Text

  responsableId Int?
  responsable   Usuario? @relation("ResponsableEmpresa", fields: [responsableId], references: [id])

  // Quién la cargó. Un vendedor sigue viendo (solo lectura) lo que creó
  // aunque después se lo reasignen a otro.
  creadoPorId Int?
  creadoPor   Usuario? @relation("CreadorEmpresa", fields: [creadoPorId], references: [id])

  contactos     Contacto[]
  oportunidades Oportunidad[]
  actividades   Actividad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("empresas")
}

model Contacto {
  id            Int           @id @default(autoincrement())
  nombre        String
  apellido      String
  oportunidadAbiertaId Int?
  documento     String?
  cargo         String?
  email         String?
  telefono      String?
  estado        EstadoEntidad @default(POTENCIAL)
  bajaDefinitiva Boolean      @default(false)
  origenId      Int?
  origen        Origen?       @relation(fields: [origenId], references: [id])
  observaciones String?       @db.Text

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  responsableId Int?
  responsable   Usuario? @relation("ResponsableContacto", fields: [responsableId], references: [id])

  // Ver Empresa.creadoPorId.
  creadoPorId Int?
  creadoPor   Usuario? @relation("CreadorContacto", fields: [creadoPorId], references: [id])

  oportunidades Oportunidad[]
  actividades   Actividad[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("contactos")
}

// ---------- Productos / servicios: planes de membresía del gimnasio ----------
// (No confundir con los planes SaaS "Básico/Profesional" de GymPro: estos son
// los productos que EL GIMNASIO le vende a sus socios).

model Producto {
  id          Int      @id @default(autoincrement())
  nombre      String
  descripcion String?  @db.Text
  precio      Decimal? @db.Decimal(10, 2)
  activo      Boolean  @default(true)

  oportunidades Oportunidad[]

  @@map("productos")
}

// ---------- Embudo comercial: etapas ----------
// Etapas precargadas para el MVP (seed). La configuración de etapas desde la
// UI queda para la Entrega Final (Módulo de administración).

model Etapa {
  id            Int       @id @default(autoincrement())
  nombre        String
  orden         Int
  tipo          TipoEtapa @default(ABIERTA)
  esClasePrueba Boolean   @default(false)
  // Se desactiva en vez de borrarse: el historial apunta a las etapas.
  activo        Boolean   @default(true)

  oportunidades   Oportunidad[]
  historialComoAnterior HistorialEtapa[] @relation("EtapaAnterior")
  historialComoNueva HistorialEtapa[] @relation("EtapaNueva")
  reaperturasHacia   SolicitudReapertura[]

  @@map("etapas")
}

// ---------- Módulo 2: oportunidades ----------

model Oportunidad {
  id     Int    @id @default(autoincrement())
  titulo String

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  contactoId Int?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  responsableId Int?
  responsable   Usuario? @relation("ResponsableOportunidad", fields: [responsableId], references: [id])

  productoId Int?
  producto   Producto? @relation(fields: [productoId], references: [id])

  etapaId Int
  etapa   Etapa @relation(fields: [etapaId], references: [id])

  valorEstimado       Decimal?           @db.Decimal(10, 2)
  probabilidadCierre  Int?
  fechaEstimadaCierre DateTime?
  fechaRealCierre     DateTime?
  fechaBaja           DateTime?
  origenId            Int?
  origen              Origen?            @relation(fields: [origenId], references: [id])
  estado              EstadoOportunidad  @default(ABIERTA)
  motivoPerdidaId      Int?
  motivoPerdida        MotivoPerdida?    @relation(fields: [motivoPerdidaId], references: [id])
  motivoPerdidaDetalle String?           @db.Text
  motivoBaja          String?
  observaciones       String?            @db.Text

  actividades           Actividad[]
  historialEtapas       HistorialEtapa[]
  solicitudesReapertura SolicitudReapertura[]
  notificaciones        Notificacion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("oportunidades")
}

// ---------- Catálogos configurables por el administrador ----------
// Mismo formato que TipoActividad: se desactivan, nunca se borran.

model Origen {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  orden  Int     @default(0)
  activo Boolean @default(true)

  empresas      Empresa[]
  contactos     Contacto[]
  oportunidades Oportunidad[]

  @@map("origenes")
}

model MotivoPerdida {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  orden  Int     @default(0)
  activo Boolean @default(true)

  oportunidades Oportunidad[]

  @@map("motivos_perdida")
}

// ---------- Módulo 3: actividades e historial comercial ----------

// Catálogo configurable de tipos de actividad (Llamada, Visita al gimnasio...).
// Se desactiva con `activo: false` en vez de borrarse: las actividades viejas
// siguen apuntando a su tipo.
model TipoActividad {
  id     Int     @id @default(autoincrement())
  nombre String  @unique
  orden  Int     @default(0)
  activo Boolean @default(true)

  actividades Actividad[]

  @@map("tipos_actividad")
}

// Una interacción que YA ocurrió (no es una tarea ni un recordatorio): no se
// edita ni se borra. Se relaciona con un contacto, una empresa y/o una
// oportunidad; al registrarla desde una oportunidad se completan su
// contacto/empresa para que aparezca en todos los historiales.
model Actividad {
  id    Int      @id @default(autoincrement())
  fecha DateTime @default(now()) // cuándo ocurrió

  tipoActividadId Int
  tipoActividad   TipoActividad @relation(fields: [tipoActividadId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  contactoId Int?
  contacto   Contacto? @relation(fields: [contactoId], references: [id])

  empresaId Int?
  empresa   Empresa? @relation(fields: [empresaId], references: [id])

  oportunidadId Int?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  descripcion String  @db.Text
  resultado   String?

  createdAt DateTime @default(now()) // cuándo se cargó

  @@index([fecha])
  @@map("actividades")
}

model HistorialEtapa {
  id Int @id @default(autoincrement())

  oportunidadId Int
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id])

  etapaAnteriorId Int?
  etapaAnterior   Etapa? @relation("EtapaAnterior", fields: [etapaAnteriorId], references: [id])
  etapaNuevaId    Int
  etapaNueva      Etapa @relation("EtapaNueva", fields: [etapaNuevaId], references: [id])

  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  fecha       DateTime @default(now())
  observacion String?

  @@map("historial_etapas")
}

// ---------- Reapertura autorizada de oportunidades perdidas ----------
// Un vendedor o responsable comercial pide reabrir una oportunidad Perdida y
// un administrador la aprueba (se reabre en la etapa pedida) o la rechaza.

model SolicitudReapertura {
  id Int @id @default(autoincrement())

  oportunidadId Int
  oportunidad   Oportunidad @relation(fields: [oportunidadId], references: [id])

  etapaDestinoId Int
  etapaDestino   Etapa @relation(fields: [etapaDestinoId], references: [id])

  solicitanteId Int
  solicitante   Usuario @relation("SolicitanteReapertura", fields: [solicitanteId], references: [id])

  motivo String          @db.Text
  estado EstadoSolicitud @default(PENDIENTE)

  resueltaPorId        Int?
  resueltaPor          Usuario?  @relation("ResolutorReapertura", fields: [resueltaPorId], references: [id])
  resueltaEn           DateTime?
  comentarioResolucion String?   @db.Text

  notificaciones Notificacion[]

  createdAt DateTime @default(now())

  @@index([estado])
  @@map("solicitudes_reapertura")
}

// ---------- Notificaciones (bandeja de cada usuario) ----------

model Notificacion {
  id Int @id @default(autoincrement())

  // Destinatario: cada usuario solo ve las suyas.
  usuarioId Int
  usuario   Usuario @relation(fields: [usuarioId], references: [id])

  tipo    TipoNotificacion
  mensaje String           @db.Text
  leida   Boolean          @default(false)

  solicitudId Int?
  solicitud   SolicitudReapertura? @relation(fields: [solicitudId], references: [id])

  oportunidadId Int?
  oportunidad   Oportunidad? @relation(fields: [oportunidadId], references: [id])

  createdAt DateTime @default(now())

  @@index([usuarioId, leida])
  @@map("notificaciones")
}
